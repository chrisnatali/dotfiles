.shell pwsh

# Start app launcher - xmonad: Mod+d -> dmenu_run
lwin + d : powershell -NoProfile -Command "Start-Process 'C:\Program Files\PowerToys\PowerToys.PowerLauncher.exe'"

# Terminal - useful xmonad-style addition
# lwin + enter : wezterm.exe

# Screenshot region - xmonad: Mod+Ctrl+s -> scrot --select
# Option 1: Windows Snipping Tool
lwin + ctrl + s : explorer.exe ms-screenclip:

# Option 2: ShareX region capture, if installed
# lwin + ctrl + s : "C:\Program Files\ShareX\ShareX.exe" -Region

# Suspend - xmonad: Mod+z -> systemctl suspend
lwin + z : rundll32.exe powrprof.dll,SetSuspendState Sleep

# Focus movement - xmonad-like vim navigation
lwin + h : komorebic focus left
lwin + j : komorebic focus down
lwin + k : komorebic focus up
lwin + l : komorebic focus right

# Move windows
lwin + shift + h : komorebic move left
lwin + shift + j : komorebic move down
lwin + shift + k : komorebic move up
lwin + shift + l : komorebic move right

# Resize, matching xmonad's resize intent
lwin + ctrl + h : komorebic resize-axis horizontal decrease
lwin + ctrl + l : komorebic resize-axis horizontal increase
lwin + ctrl + j : komorebic resize-axis vertical increase
lwin + ctrl + k : komorebic resize-axis vertical decrease

# Cycle layouts: Tall / Mirror Tall / Full / ThreeCol-ish
lwin + space : komorebic cycle-layout
lwin + shift + space : komorebic retile

# Fullscreen / monocle-ish behavior
lwin + f : komorebic toggle-monocle
lwin + shift + f : komorebic toggle-float

# Close focused window
lwin + shift + c : komorebic close

# Workspaces 1-9
lwin + 1 : komorebic focus-workspace 0
lwin + 2 : komorebic focus-workspace 1
lwin + 3 : komorebic focus-workspace 2
lwin + 4 : komorebic focus-workspace 3
lwin + 5 : komorebic focus-workspace 4
lwin + 6 : komorebic focus-workspace 5
lwin + 7 : komorebic focus-workspace 6
lwin + 8 : komorebic focus-workspace 7
lwin + 9 : komorebic focus-workspace 8

# Move windows to workspaces 1-9
lwin + shift + 1 : komorebic move-to-workspace 0
lwin + shift + 2 : komorebic move-to-workspace 1
lwin + shift + 3 : komorebic move-to-workspace 2
lwin + shift + 4 : komorebic move-to-workspace 3
lwin + shift + 5 : komorebic move-to-workspace 4
lwin + shift + 6 : komorebic move-to-workspace 5
lwin + shift + 7 : komorebic move-to-workspace 6
lwin + shift + 8 : komorebic move-to-workspace 7
lwin + shift + 9 : komorebic move-to-workspace 8

# Restart/stop Komorebi
lwin + shift + r : komorebic stop && komorebic start --whkd
lwin + shift + q : komorebic stop
